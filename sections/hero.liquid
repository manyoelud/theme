{% schema
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to our store"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Discover amazing products</p>"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Now"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}

<section class="hero" style="background-image: url('{{ section.settings.background_image | img_url: "1200x600" }}');">
  <div class="hero-content">
    <h1 class="hero-heading">{{ section.settings.heading }}</h1>
    <div class="hero-subheading">
      {{ section.settings.subheading }}
    </div>
    {% if section.settings.button_url %}
      <a href="{{ section.settings.button_url }}" class="button button-primary">
        {{ section.settings.button_text }}
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
.hero {
  background-size: cover;
  background-position: center;
  min-height: 400px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: white;
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
}

.hero-content {
  max-width: 600px;
  padding: 2rem;
}

.hero-heading {
  font-size: 3rem;
  margin-bottom: 1rem;
  font-weight: bold;
}

.hero-subheading {
  font-size: 1.25rem;
  margin-bottom: 2rem;
}

.button {
  display: inline-block;
  padding: 0.75rem 2rem;
  text-decoration: none;
  border-radius: 4px;
  transition: all 0.3s ease;
}

.button-primary {
  background-color: {{ settings.colors_accent }};
  color: white;
}

.button-primary:hover {
  opacity: 0.9;
}
{% endstylesheet %}
