{% schema
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Number of products",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}

<section class="featured-products">
  <div class="container">
    <h2 class="section-heading">{{ section.settings.heading }}</h2>
    <div class="products-grid">
      {% for product in shop.products limit: section.settings.products_count %}
        <div class="product-card">
          {% if product.featured_image %}
            <div class="product-image">
              <img src="{{ product.featured_image | img_url: '300x300' }}" alt="{{ product.title }}">
            </div>
          {% endif %}
          <h3 class="product-title">{{ product.title }}</h3>
          <p class="product-price">
            {% if product.available %}
              {{ product.price | money }}
            {% else %}
              Sold out
            {% endif %}
          </p>
          <a href="{{ product.url }}" class="button button-secondary">View Product</a>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
.featured-products {
  padding: 3rem 1rem;
  background-color: #f9f9f9;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
}

.section-heading {
  text-align: center;
  font-size: 2rem;
  margin-bottom: 2rem;
  color: {{ settings.colors_primary_text }};
}

.products-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 2rem;
}

.product-card {
  background: white;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  transition: transform 0.3s ease;
}

.product-card:hover {
  transform: translateY(-5px);
}

.product-image {
  width: 100%;
  overflow: hidden;
}

.product-image img {
  width: 100%;
  height: auto;
  display: block;
}

.product-title {
  padding: 1rem 1rem 0;
  font-size: 1rem;
  margin: 0;
  color: {{ settings.colors_primary_text }};
}

.product-price {
  padding: 0.5rem 1rem;
  color: {{ settings.colors_accent }};
  font-weight: bold;
  margin: 0;
}

.button-secondary {
  display: block;
  margin: 1rem;
  text-align: center;
  background-color: {{ settings.colors_accent }};
  color: white;
}

.button-secondary:hover {
  opacity: 0.9;
}
{% endstylesheet %}
